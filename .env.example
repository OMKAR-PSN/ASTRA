# Environment variable template for ASTRA CARE
# Copy this file to .env.local and fill in values for your local setup.
# .env.local is gitignored and must never be committed.

# ------------------------------------------------------------------
# SIMULATED GROUND RECEIVER
# ------------------------------------------------------------------
# URL of the local Fastify simulated receiver.
# Leave unset to run ASTRA CARE without a receiver — all local
# features (check-in, assessment, replay, knowledge hub) work fully.
# Only the final report-send step requires a reachable receiver.
#
# Development (browser talking to local receiver):
#   EXPO_PUBLIC_RECEIVER_URL=http://127.0.0.1:8787
#
# Phone via Expo Go on the same LAN (use your PC's actual IP):
#   EXPO_PUBLIC_RECEIVER_URL=http://192.168.1.10:8787
#
# Note: on a phone, localhost/127.0.0.1 refers to the phone itself.
# On iOS, plain HTTP to a local IP may be blocked by App Transport
# Security; use HTTPS or add an ATS exception for testing only.
EXPO_PUBLIC_RECEIVER_URL=
