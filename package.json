{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "build:web": "expo export --platform web --output-dir dist/web --max-workers 1 && node scripts/build-web-cache.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "receiver": "node ground-receiver/start.mjs",
    "test:receiver": "node --test ground-receiver/receiver.test.mjs",
    "test:crew": "node --import ./tests/register-loader.mjs --test tests/crewIdentity.test.mjs",
    "test:guided": "node --import ./tests/register-loader.mjs --test tests/guidedCheckIn.test.mjs",
    "test:assessment": "node --import ./tests/register-loader.mjs --test tests/assessment.test.mjs",
    "start": "expo start",
    "start:phone": "expo start --go --lan --clear",
    "start:tunnel": "expo start --go --tunnel --clear",
    "web": "expo start --web",
    "test:replay": "node --import ./tests/register-loader.mjs --test tests/replay.test.mjs",
    "test:engagement": "node --import ./tests/register-loader.mjs --test tests/engagement.test.mjs",
    "test:symptoms": "node --import ./tests/register-loader.mjs --test tests/symptoms.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@fastify/cors": "^11.4.3",
    "@lucide/lab": "^0.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "fastify": "^5.12.8",
    "lucide-react-native": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
